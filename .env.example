# Copy to .env and edit before running the full stack:
#   cp .env.example .env
#
# Only needed for docker-compose.full.yml. The app-only compose reads its
# settings from ./config/application-local.yml instead.

# --- Required: startup fails without these -------------------------------
POSTGRES_PASSWORD=change-me
ADMIN_PASSWORD=change-me

# --- Optional: defaults shown --------------------------------------------
POSTGRES_DB=weather_station
POSTGRES_USER=weather
ADMIN_USERNAME=admin

# Topic the station publishes readings to. See README for the payload shape.
MQTT_TOPIC=weather/station

# Host ports. Change if something already owns 8080 or 1883.
APP_PORT=8080
MQTT_HOST_PORT=1883

# Drives log timestamps and the retention job's 02:00 window.
TZ=UTC
